* { box-sizing: border-box; margin: 0; padding: 0; }

body {
  font-family: "Segoe UI", Arial, sans-serif;
  background: #0f0f14;
  color: #f1f1f1;
  min-height: 100vh;
}

header { text-align: center; padding: 30px 16px 10px; }
header h1 { font-size: 2.4rem; color: #e50914; }
header p  { color: #aaa; margin-top: 4px; }

.controls {
  display: flex; gap: 12px; justify-content: center;
  flex-wrap: wrap; padding: 16px;
}
.controls input, .controls select {
  padding: 10px 14px; border-radius: 8px;
  border: 1px solid #333; background: #1c1c24; color: #fff;
  font-size: 1rem; min-width: 220px;
}
.grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
  gap: 20px;
  padding: 20px;
  max-width: 1100px;
  margin: 0 auto;
}
.card {
  background: #1c1c24;
  border-radius: 12px;
  overflow: hidden;
  cursor: pointer;
}
.card img { width: 100%; display: block; }
.card .info { padding: 10px; font-size: 0.85rem; }
.card h3 { font-size: 1rem; margin-bottom: 4px; }
#status { text-align: center; color: #aaa; margin: 10px; }
.modal {
  position: fixed; inset: 0;
  background: rgba(0,0,0,0.8);
  display: flex; align-items: center; justify-content: center;
  overflow: auto;
}
.modal.hidden { display: none; }
.modal-content {
  background: #1c1c24;
  max-width: 600px; width: 90%;
  padding: 20px; border-radius: 12px;
}
footer { text-align: center; color: #888; padding: 30px; font-size: 0.8rem; }